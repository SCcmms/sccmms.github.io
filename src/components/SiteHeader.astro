---
import Container from "./Container.astro";
import { navItems } from "../data/site";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<header class="relative z-20">
  <Container
    class="flex flex-col gap-8 pt-8 lg:flex-row lg:items-start lg:justify-between lg:pt-[63px]"
  >
    <a href="/" aria-label="Lyneodata home">
      <img
        src="/assets/home/logo.png"
        alt="Lyneodata"
        class="h-auto w-[210px] sm:w-[260px] lg:w-[322px]"
      />
    </a>

    <nav
      aria-label="Main navigation"
      class="hidden items-center gap-5 pt-[18px] lg:flex"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="group flex items-center gap-5 font-inter text-[20px] font-semibold leading-none tracking-[1px] text-white transition-colors hover:text-primary"
            aria-current={currentPath === item.href ? "page" : undefined}
          >
            <span>{item.label}</span>
            <span
              class="h-px w-[50px] bg-white/55 transition-colors group-hover:bg-primary"
              aria-hidden="true"
            />
          </a>
        ))
      }
    </nav>

    <nav
      aria-label="Mobile navigation"
      class="flex flex-wrap gap-x-5 gap-y-3 font-inter text-sm font-semibold uppercase tracking-[0.08em] text-white/90 lg:hidden"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </Container>
</header>
