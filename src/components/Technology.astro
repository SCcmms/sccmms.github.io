---
const navItems = [
  { label: "Nasza misja", href: "/o-nas/" },
  { label: "Projekty", href: "/#projekty" },
  { label: "Technologia", href: "/technologia/" },
  { label: "Nasz zespół", href: "/#zespol" },
  { label: "Kontakt", href: "/#kontakt" },
];

const integrations = [
  "systemy SCADA / DCS",
  "systemy klasy ERP, MES oraz CMMS",
  "dokumentację techniczną i procesową",
  "systemy diagnostyczne i monitoringu stanu technicznego",
];

const technologyCards = [
  {
    title: "Integracja danych",
    body: "Łączy informacje z rozproszonych źródeł i porządkuje je w spójny model operacyjny.",
  },
  {
    title: "Warstwa analityczna",
    body: "Ułatwia analizę trendów, jakości, efektywności oraz przyczyn problemów w procesach.",
  },
  {
    title: "Agentic AI",
    body: "Zapewnia szybki dostęp do wiedzy zapisanej w dokumentacji, systemach i wynikach analiz.",
  },
];
---

<main class="overflow-hidden bg-white font-poppins text-[#2d2d2d]">
  <section
    class="relative min-h-[720px] overflow-hidden bg-[#030707] bg-[url('/assets/technology/hero.png')] bg-[length:100%_100%] bg-center bg-no-repeat text-white lg:min-h-[810px]"
    aria-labelledby="technology-title"
  >
    <div class="absolute inset-0 bg-black/10"></div>

    <header
      class="relative z-20 mx-auto flex w-full max-w-[1760px] flex-col gap-8 px-6 pt-8 sm:px-10 lg:flex-row lg:items-start lg:justify-between lg:px-20 lg:pt-[63px]"
    >
      <a href="/" aria-label="Lyneodata home">
        <img
          src="/assets/home/logo.png"
          alt="Lyneodata"
          class="h-auto w-[210px] sm:w-[260px] lg:w-[322px]"
        />
      </a>

      <nav aria-label="Main navigation" class="hidden items-center gap-5 pt-[18px] lg:flex">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="group flex items-center gap-5 font-inter text-[20px] font-semibold leading-none tracking-[1px] text-white transition-colors hover:text-primary"
              aria-current={item.href === "/technologia/" ? "page" : undefined}
            >
              <span>{item.label}</span>
              <span class="h-px w-[50px] bg-white/55 transition-colors group-hover:bg-primary" aria-hidden="true" />
            </a>
          ))
        }
        <span class="font-inter text-[20px] font-semibold leading-none tracking-[1px]">PL</span>
      </nav>

      <nav aria-label="Mobile navigation" class="flex flex-wrap gap-x-5 gap-y-3 font-inter text-sm font-semibold uppercase tracking-[0.08em] text-white/90 lg:hidden">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>

    <div class="relative z-10 mx-auto flex min-h-[500px] w-full max-w-[1380px] flex-col items-center justify-center px-6 pb-20 pt-20 text-center lg:min-h-[620px] lg:pt-12">
      <h1
        id="technology-title"
        class="text-[44px] font-bold uppercase leading-none tracking-[0.08em] text-white sm:text-6xl md:text-7xl xl:text-[90px]"
      >
        Lyneodata Platform
      </h1>
      <p class="mt-8 max-w-[880px] text-[23px] font-bold leading-[1.22] text-white md:text-[34px]">
        Morbi lacinia in lorem non viverra. Morbi non arcu sit amet augue cursus sodales non vel dolor.
      </p>
    </div>
  </section>

  <section class="relative overflow-hidden bg-white py-24 lg:min-h-[780px] lg:py-0">
    <div class="mx-auto grid w-full max-w-[1760px] items-center gap-14 px-6 sm:px-10 lg:grid-cols-[0.78fr_1.22fr] lg:px-20">
      <div class="relative z-10 max-w-[610px] lg:pl-[160px]">
        <div class="flex items-center gap-8">
          <h2 class="text-[52px] font-bold leading-[1.08] md:text-[66px]">
            <span class="block text-primary">Integracja</span>
            <span class="block">danych</span>
          </h2>
          <span class="hidden h-px w-[210px] bg-[#2d2d2d]/65 lg:block" aria-hidden="true"></span>
        </div>
        <p class="mt-12 text-[22px] font-bold leading-[1.32] md:text-[27px]">
          Odpowiedzią na powyższe wyzwania jest <span class="text-primary">LyneoData Platform (LDP)</span> - kompleksowe rozwiązanie umożliwiające integrację, normalizację i analizę danych z wielu, często rozproszonych źródeł.
        </p>
      </div>

      <img
        src="/assets/technology/integration-device.png"
        alt="Platforma LyneoData prezentowana na ekranie w hali produkcyjnej"
        class="relative z-10 w-full object-contain drop-shadow-2xl lg:mt-[-90px]"
      />
    </div>
  </section>

  <section class="bg-white pb-28 pt-10 lg:pb-[190px] lg:pt-0">
    <div class="mx-auto grid w-full max-w-[1760px] items-center gap-14 px-6 sm:px-10 lg:grid-cols-[1fr_0.9fr] lg:px-20">
      <img
        src="/assets/technology/data-desk.png"
        alt="Analityk pracujący przy ekranach z danymi produkcyjnymi"
        class="w-full object-contain"
      />

      <div class="max-w-[630px] lg:pl-10">
        <div class="flex items-end gap-8">
          <h2 class="text-[48px] font-bold leading-[1.08] md:text-[64px]">
            <span class="block text-[#ef7b2c]">Platforma LDP</span>
            <span class="block">integruje m.in.:</span>
          </h2>
          <span class="hidden h-px w-[120px] bg-[#2d2d2d]/55 xl:block" aria-hidden="true"></span>
        </div>

        <ul class="mt-14 space-y-4 text-[22px] font-bold leading-[1.28] md:text-[27px]">
          {
            integrations.map((item) => (
              <li class="flex gap-8">
                <span class="mt-3 size-3 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <p class="mt-20 text-[22px] font-bold leading-[1.32] md:text-[27px]">
          Dzięki temu LyneoData Platform tworzy jedno, spójne źródło wiedzy o procesach produkcyjnych, wspierając świadome decyzje operacyjne, optymalizację oraz rozwój rozwiązań predykcyjnych.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white px-6 pb-24 text-center sm:px-10 lg:pb-[170px]">
    <h2 class="mx-auto max-w-[960px] text-[44px] font-bold leading-[1.18] md:text-[64px]">
      Racjonalne wykorzystanie możliwości <span class="text-primary">agentic AI</span>
    </h2>
    <p class="mx-auto mt-12 max-w-[760px] text-[24px] font-bold leading-[1.25] md:text-[32px]">
      Moduł LDP Agent oparty o modele językowe umożliwia szybkie dostęp do wiedzy
    </p>
  </section>

  <section class="relative overflow-hidden bg-[#041016] py-24 text-white lg:py-[150px]">
    <div class="absolute inset-0 bg-gradient-to-r from-[#102c38] via-[#030707] to-black"></div>
    <div class="relative mx-auto w-full max-w-[1760px] px-6 sm:px-10 lg:px-20">
      <h2 class="text-center text-[42px] font-bold leading-[1.15] md:text-[64px]">
        LyneoData Platform - <span class="text-primary">technologia</span>
      </h2>

      <div class="relative mx-auto mt-20 min-h-[560px] w-full max-w-[1600px]">
        <img
          src="/assets/technology/ai-portrait.png"
          alt=""
          class="absolute left-0 top-[105px] hidden w-[24%] rounded-[28px] object-cover opacity-30 grayscale shadow-2xl md:block"
        />
        <img
          src="/assets/technology/ai-portrait.png"
          alt=""
          class="absolute left-[8%] top-[140px] hidden w-[22%] rounded-[28px] object-cover opacity-65 blur-[1px] md:block"
        />
        <img
          src="/assets/technology/ai-dashboard.png"
          alt=""
          class="absolute right-[2%] top-[130px] hidden w-[24%] rounded-[28px] object-cover opacity-70 shadow-2xl md:block"
        />

        <article class="relative z-10 mx-auto flex min-h-[430px] w-full max-w-[1120px] flex-col items-center justify-end overflow-hidden rounded-[28px] bg-black shadow-2xl md:min-h-[520px]">
          <img
            src="/assets/technology/ai-main.png"
            alt="Generatywna sztuczna inteligencja w module LyneoData Platform"
            class="absolute inset-0 size-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-black/0 via-black/5 to-black/55"></div>
          <div class="relative z-10 max-w-[920px] px-6 pb-16 text-center">
            <h3 class="text-[38px] font-bold leading-[1.1] text-white md:text-[64px]">
              Generatywna sztuczna inteligencja
            </h3>
            <p class="mt-8 text-[20px] font-semibold leading-[1.35] text-white md:text-[28px]">
              umożliwia analizę dokumentów, root cause analysis, łączenie dokumentacji i wyników pracy systemów analitycznych.
            </p>
          </div>
        </article>

        <a
          href="#kontakt"
          class="mx-auto mt-16 flex h-[60px] w-[240px] items-center justify-center rounded-md bg-primary text-[24px] font-bold text-white transition-colors hover:bg-[#367fac]"
        >
          Więcej
        </a>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-3">
        {
          technologyCards.map((card) => (
            <article class="border-l border-white/25 pl-6">
              <h3 class="text-[26px] font-bold leading-tight text-primary">{card.title}</h3>
              <p class="mt-4 font-inter text-[17px] font-semibold leading-[1.45] text-white/85">{card.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <footer id="kontakt" class="relative overflow-hidden bg-[#030f10] py-16 text-white lg:min-h-[340px]">
    <img
      src="/assets/technology/footer.png"
      alt=""
      class="absolute inset-0 size-full object-cover opacity-35 mix-blend-screen"
    />
    <div class="absolute inset-0 bg-[#020707]/88"></div>

    <div class="relative mx-auto grid w-full max-w-[1760px] gap-12 px-6 sm:px-10 lg:grid-cols-[0.9fr_1fr_0.85fr] lg:items-center lg:px-20">
      <div class="border-l border-white/35 pl-10 lg:pl-14">
        <div class="flex items-center gap-6">
          <svg class="size-9 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.32 1.78.59 2.63a2 2 0 0 1-.45 2.11L8 9.71a16 16 0 0 0 6.29 6.29l1.25-1.25a2 2 0 0 1 2.11-.45c.85.27 1.73.47 2.63.59A2 2 0 0 1 22 16.92Z" />
          </svg>
          <p class="font-poppins text-[26px] font-bold leading-none">123 456 789</p>
        </div>
        <div class="mt-8 flex items-center gap-6">
          <svg class="size-9 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          <a href="mailto:biuro@lyneodata.com" class="font-poppins text-[26px] font-bold leading-none">biuro@lyneodata.com</a>
        </div>
      </div>

      <div class="border-l border-white/35 pl-10 lg:pl-14">
        <div class="flex items-center gap-6">
          <svg class="size-10 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <p class="font-poppins text-[25px] font-bold leading-tight">Aenean facilisis massa</p>
        </div>
      </div>

      <img src="/assets/home/logo.png" alt="Lyneodata" class="w-[260px] justify-self-start lg:w-[320px] lg:justify-self-end" />
    </div>
  </footer>
</main>
