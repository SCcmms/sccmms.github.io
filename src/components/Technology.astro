---
import Container from "./Container.astro";
import PageHero from "./PageHero.astro";
import SiteFooter from "./SiteFooter.astro";
import { integrations, technologyCards } from "../data/technology";
---

<main class="overflow-hidden bg-white font-poppins text-ink">
  <PageHero
    backgroundImage="/assets/technology/hero.png"
    currentPath="/technologia/"
    titleId="technology-title"
  >
    Lyneodata Platform
  </PageHero>

  <section
    class="relative overflow-hidden bg-white py-24 lg:min-h-[780px] lg:py-0"
  >
    <Container class="grid items-center gap-14 lg:grid-cols-[0.78fr_1.22fr]">
      <div class="relative z-10 max-w-[610px] lg:pl-[160px]">
        <div class="flex items-center gap-8">
          <h2 class="text-[52px] font-bold leading-[1.08] md:text-[66px]">
            <span class="block text-primary">Integracja</span>
            <span class="block">danych</span>
          </h2>
          <span
            class="hidden h-px w-[210px] bg-ink/65 lg:block"
            aria-hidden="true"></span>
        </div>
        <p class="mt-12 text-[22px] font-bold leading-[1.32] md:text-[27px]">
          Odpowiedzią na powyższe wyzwania jest <span class="text-primary"
            >LyneoData Platform (LDP)</span
          > - kompleksowe rozwiązanie umożliwiające integrację, normalizację i analizę
          danych z wielu, często rozproszonych źródeł.
        </p>
      </div>

      <img
        src="/assets/technology/integration-device.png"
        alt="Platforma LyneoData prezentowana na ekranie w hali produkcyjnej"
        class="relative z-10 w-full object-contain drop-shadow-2xl lg:mt-[-90px]"
      />
    </Container>
  </section>

  <section class="bg-white pb-28 pt-10 lg:pb-[190px] lg:pt-0">
    <Container class="grid items-center gap-14 lg:grid-cols-[1fr_0.9fr]">
      <img
        src="/assets/technology/data-desk.png"
        alt="Analityk pracujący przy ekranach z danymi produkcyjnymi"
        class="w-full object-contain"
      />

      <div class="max-w-[630px] lg:pl-10">
        <div class="flex items-end gap-8">
          <h2 class="text-[48px] font-bold leading-[1.08] md:text-[64px]">
            <span class="block text-brand-orange">Platforma LDP</span>
            <span class="block">integruje m.in.:</span>
          </h2>
          <span
            class="hidden h-px w-[120px] bg-ink/55 xl:block"
            aria-hidden="true"></span>
        </div>

        <ul
          class="mt-14 flex flex-col gap-4 text-[22px] font-bold leading-[1.28] md:text-[27px]"
        >
          {
            integrations.map((item) => (
              <li class="flex gap-8">
                <span
                  class="mt-3 size-3 shrink-0 rounded-full bg-primary"
                  aria-hidden="true"
                />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <p class="mt-20 text-[22px] font-bold leading-[1.32] md:text-[27px]">
          Dzięki temu LyneoData Platform tworzy jedno, spójne źródło wiedzy o
          procesach produkcyjnych, wspierając świadome decyzje operacyjne,
          optymalizację oraz rozwój rozwiązań predykcyjnych.
        </p>
      </div>
    </Container>
  </section>

  <section class="bg-white px-6 pb-24 text-center sm:px-10 lg:pb-[170px]">
    <h2
      class="mx-auto max-w-[960px] text-[44px] font-bold leading-[1.18] md:text-[64px]"
    >
      Racjonalne wykorzystanie możliwości <span class="text-primary"
        >agentic AI</span
      >
    </h2>
    <p
      class="mx-auto mt-12 max-w-[760px] text-[24px] font-bold leading-[1.25] md:text-[32px]"
    >
      Moduł LDP Agent oparty o modele językowe umożliwia szybkie dostęp do
      wiedzy
    </p>
  </section>

  <section
    class="relative overflow-hidden bg-surface-technology py-24 text-white lg:py-[150px]"
  >
    <div
      class="absolute inset-0 bg-gradient-to-r from-surface-technology-glow via-surface-page-hero to-black"
    >
    </div>
    <Container class="relative">
      <h2
        class="text-center text-[42px] font-bold leading-[1.15] md:text-[64px]"
      >
        LyneoData Platform - <span class="text-primary">technologia</span>
      </h2>

      <div class="relative mx-auto mt-20 min-h-[560px] w-full max-w-[1600px]">
        <img
          src="/assets/technology/ai-portrait.png"
          alt=""
          class="absolute left-0 top-[105px] hidden w-[24%] rounded-[28px] object-cover opacity-30 grayscale shadow-2xl md:block"
        />
        <img
          src="/assets/technology/ai-portrait.png"
          alt=""
          class="absolute left-[8%] top-[140px] hidden w-[22%] rounded-[28px] object-cover opacity-65 blur-[1px] md:block"
        />
        <img
          src="/assets/technology/ai-dashboard.png"
          alt=""
          class="absolute right-[2%] top-[130px] hidden w-[24%] rounded-[28px] object-cover opacity-70 shadow-2xl md:block"
        />

        <article
          class="relative z-10 mx-auto flex min-h-[430px] w-full max-w-[1120px] flex-col items-center justify-end overflow-hidden rounded-[28px] bg-black shadow-2xl md:min-h-[520px]"
        >
          <img
            src="/assets/technology/ai-main.png"
            alt="Generatywna sztuczna inteligencja w module LyneoData Platform"
            class="absolute inset-0 size-full object-cover"
          />
          <div
            class="absolute inset-0 bg-gradient-to-b from-black/0 via-black/5 to-black/55"
          >
          </div>
          <div class="relative z-10 max-w-[920px] px-6 pb-16 text-center">
            <h3
              class="text-[38px] font-bold leading-[1.1] text-white md:text-[64px]"
            >
              Generatywna sztuczna inteligencja
            </h3>
            <p
              class="mt-8 text-[20px] font-semibold leading-[1.35] text-white md:text-[28px]"
            >
              umożliwia analizę dokumentów, root cause analysis, łączenie
              dokumentacji i wyników pracy systemów analitycznych.
            </p>
          </div>
        </article>

        <a
          href="#kontakt"
          class="mx-auto mt-16 flex h-[60px] w-[240px] items-center justify-center rounded-md bg-primary text-[24px] font-bold text-white transition-colors hover:bg-brand-primary-hover"
        >
          Więcej
        </a>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-3">
        {
          technologyCards.map((card) => (
            <article class="border-l border-white/25 pl-6">
              <h3 class="text-[26px] font-bold leading-tight text-primary">
                {card.title}
              </h3>
              <p class="mt-4 font-inter text-[17px] font-semibold leading-[1.45] text-white/85">
                {card.body}
              </p>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <SiteFooter id="kontakt" />
</main>
