---
import Container from "./Container.astro";
import { contact } from "../data/site";

interface Props {
  id?: string;
}

const { id = "stopka" } = Astro.props;
---

<footer
  class="relative lg:overflow-hidden bg-surface-footer lg:py-16 text-white lg:min-h-[340px]"
  id={id}
>
  <img
    src="/assets/home/footer-texture.png"
    alt=""
    class="absolute inset-0 size-full object-cover opacity-30 mix-blend-screen"
  />
  <Container
    class="relative flex flex-col gap-0 lg:grid lg:gap-12 lg:grid-cols-[1fr_1.15fr_0.8fr] items-center"
  >
    <div class="lg:border-l border-white/35 lg:pl-14">
      <a
        href={`mailto:${contact.email}`}
        class="h-16 pt-4 block text-lg lg:text-3xl tracking-[0.002em] font-poppins lg:font-semibold leading-[1.1] transition-colors hover:text-primary"
      >
        {contact.email}
      </a>
    </div>
    <div class="lg:border-l border-white/35 lg:pl-14">
      <address
        class="mt-4 lg:mt-0 font-poppins text-lg lg:text-3xl lg:font-semibold not-italic leading-[1]"
      >
        {contact.address}
      </address>
    </div>
    <img
      src="/assets/home/logo.png"
      alt="Lyneodata"
      class="my-8 lg:my-0 w-[260px] justify-self-start lg:w-[320px] lg:justify-self-end"
    />
  </Container>
</footer>
