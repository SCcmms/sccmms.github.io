---
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";

const capabilities = [
  "Modelowanie procesów i pracy urządzeń",
  "Monitoring i optymalizacja produktów",
  "Monitoring pracy urządzeń i procesów",
  "Automatyzacja procesów wewnętrznych",
  "Optymalizacja procesu, zużycia oraz energii",
  "Prognozowanie wartości na bazie danych",
];

const workSteps = [
  {
    eyebrow: "Zbierz dane",
    title: ["Z różnych", "źródeł"],
    body:
      "Dane z systemów produkcyjnych, utrzymania ruchu, jakości i dokumentacji technicznej są konsolidowane w jednym miejscu, aby stworzyć pełny obraz pracy zakładu.",
    image: "/assets/home/work-data.png",
    imageAlt: "Analityczka przeglądająca dane produkcyjne na panelu wizualnym",
  },
  {
    eyebrow: "Wykorzystaj potencjał",
    title: ["Platformy", "LyneoData"],
    body:
      "LyneoData Platform porządkuje rozproszone informacje, łączy je z kontekstem operacyjnym i udostępnia zespołom przemysłowym w formie gotowej do analizy oraz podejmowania decyzji.",
    image: "/assets/home/work-platform.png",
    imageAlt: "Wizualizacja danych w chmurze na urządzeniu mobilnym",
    reverse: true,
  },
  {
    eyebrow: "Osiągnij",
    title: ["rezultat"],
    body:
      "Lepszy dostęp do danych wspiera szybszą diagnostykę, ograniczanie przestojów, optymalizację procesów i rozwój predykcyjnego podejścia do zarządzania produkcją.",
    image: "/assets/home/work-result.png",
    imageAlt: "Specjaliści produkcji omawiają wyniki na hali przemysłowej",
  },
];
---

<main class="min-h-screen overflow-hidden bg-[#020707] text-white">
  <section
    id="hero"
    class="relative flex min-h-screen flex-col bg-black/40 bg-[url('/assets/home/hero-bg-figma.png')] bg-cover bg-center bg-blend-darken"
  >
    <div class="absolute inset-0 bg-black/20"></div>

    <SiteHeader />

    <div class="relative z-10 mx-auto flex w-full max-w-[1500px] flex-1 flex-col items-center justify-center px-6 pb-28 pt-16 text-center lg:pb-36 lg:pt-10">
      <h1
        class="font-poppins text-[40px] font-semibold uppercase leading-[1.05] tracking-[0.025em] text-white sm:text-6xl md:text-7xl xl:text-[120px] xl:leading-none"
      >
        The voice of<br />manufacturing<br />data
      </h1>
      <a
        href="/o-nas"
        class="mt-8 inline-flex h-[60px] w-[240px] items-center justify-center rounded-md bg-primary font-poppins text-[24px] font-semibold leading-none text-white transition-colors hover:bg-[#367fac] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40"
      >
        Więcej o nas
      </a>
    </div>

    <div class="relative z-10 mx-auto mb-12 flex w-full max-w-[1760px] items-end gap-4 px-6 sm:px-10 lg:px-20">
      <div class="mb-[11px] hidden h-px flex-1 bg-white/35 md:block"></div>
    </div>
  </section>

  <section
    id="misja"
    class="relative overflow-hidden bg-[#020c0d] py-24 lg:min-h-[1080px] lg:py-[135px]"
  >
    <img
      src="/assets/home/services-texture.png"
      alt=""
      class="absolute inset-0 size-full object-cover opacity-25 mix-blend-screen"
    />
    <div class="relative mx-auto flex min-h-[780px] w-full max-w-[1760px] flex-col px-6 sm:px-10 lg:px-20">
      <h2 class="font-poppins text-4xl font-semibold uppercase leading-tight tracking-[0.05em] text-white md:text-5xl xl:text-[64px] xl:leading-none">
        Co możesz zrealizować?
      </h2>

      <div class="mt-20 grid gap-x-20 gap-y-16 md:grid-cols-2 xl:mt-32 xl:grid-cols-3">
        {
          capabilities.map((capability) => (
            <article class="flex min-h-[190px] flex-col justify-between">
              <h3 class="max-w-[390px] font-poppins text-[28px] font-semibold uppercase leading-tight tracking-[0.05em] text-primary xl:text-[36px] xl:leading-[1.2]">
                {capability}
              </h3>
              <a href="/technologia" class="group mt-8 flex items-center gap-5 font-inter text-[14px] font-semibold text-white">
                <span class="flex size-[50px] items-center justify-center rounded-full bg-primary text-white transition-colors group-hover:bg-[#367fac]">
                  <span class="ml-0.5 text-[18px]" aria-hidden="true">›</span>
                </span>
                <span>Więcej</span>
                <span class="h-px flex-1 bg-white/45" aria-hidden="true"></span>
              </a>
            </article>
          ))
        }
      </div>

      <div id="kontakt" class="mt-auto flex flex-col gap-8 pt-20 md:flex-row md:items-center">
        <div class="h-px flex-1 bg-white/45"></div>
        <div class="flex flex-wrap items-center gap-4 font-inter md:justify-end md:gap-6">
          <div class="text-left font-semibold tracking-[1px] md:text-right">
            <p class="text-base leading-6  md:text-[20px]">Chcesz się</p>
            <p class="text-2xl leading-[1.1] tracking-[1.5px] text-white md:text-[30px] md:leading-[35px]">skontaktować?</p>
          </div>
          <a href="mailto:biuro@lyneodata.com" class="group flex items-center gap-4 text-base font-semibold tracking-[1px] md:text-[20px]">
            <span class="flex size-[50px] items-center justify-center rounded-full bg-primary transition-colors group-hover:bg-[#367fac]">
              <span class="ml-0.5 text-[18px]" aria-hidden="true">›</span>
            </span>
            Wyślij wiadomość
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    id="technologia"
    class="relative min-h-[920px] overflow-hidden bg-white bg-[url('/assets/home/platform-bg.png')] bg-cover bg-center"
  >
    <div class="absolute inset-0 bg-gradient-to-r from-white via-white/82 to-white/5"></div>
    <div class="relative mx-auto flex min-h-[920px] w-full max-w-[1760px] items-center px-6 py-24 sm:px-10 lg:px-20">
      <div class="max-w-[660px]">
        <h2 class="font-poppins text-5xl font-semibold leading-tight text-[#2c2c2c] md:text-[64px] md:leading-[1.2]">
          <span class="block text-primary">Lyneodata</span>
          <span class="flex items-center gap-8">
            Platform
            <span class="hidden h-px w-[180px] bg-[#2c2c2c]/45 sm:block" aria-hidden="true"></span>
          </span>
        </h2>
        <p class="mt-8 font-poppins text-xl font-semibold leading-[1.42] text-[#2c2c2c] md:text-[24px]">
          LyneoData Platform tworzy jedno, spójne źródło wiedzy o procesach produkcyjnych, wspierając świadome decyzje operacyjne, optymalizację oraz rozwój rozwiązań predykcyjnych.
        </p>
        <a href="/technologia/" class="group mt-12 inline-flex items-center gap-5 font-poppins text-[18px] font-semibold text-[#2c2c2c]">
          <span class="flex size-[50px] items-center justify-center rounded-full bg-primary text-white transition-colors group-hover:bg-[#367fac]">
            <span class="ml-0.5 text-[18px]" aria-hidden="true">›</span>
          </span>
          <span>Poznaj naszą technologię</span>
          <span class="hidden h-px w-[180px] bg-[#2c2c2c]/45 sm:block" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </section>

  <section id="projekty" class="relative overflow-hidden bg-[#031313] py-24 lg:min-h-[920px] lg:py-0">
    <img
      src="/assets/home/services-texture.png"
      alt=""
      class="absolute inset-0 size-full object-cover opacity-20 mix-blend-screen"
    />
    <div class="relative mx-auto grid min-h-[740px] w-full max-w-[1760px] items-center gap-16 px-6 sm:px-10 lg:grid-cols-[0.9fr_1fr] lg:px-20">
      <div class="relative mx-auto h-[460px] w-full max-w-[720px] sm:h-[560px]">
        <img
            src="/assets/technology/ai-dashboard.png"
          alt="Wizualizacja danych w chmurze na urządzeniu mobilnym"
          class="absolute left-0 top-0 h-[70%] w-[72%] rounded-[8px] object-cover shadow-2xl"
        />
        <img
            src="/assets/home/project-cloud-a.png"
          alt=""
          class="absolute bottom-0 right-0 h-[62%] w-[64%] rounded-[8px] object-cover shadow-2xl"
        />
      </div>
      <div class="max-w-[660px]">
        <h2 class="font-poppins text-5xl font-semibold leading-tight md:text-[64px] md:leading-[1.1]">
          <span class="block text-white">Poznaj nasze</span>
          <span class="flex items-center gap-8 text-[#e39b43]">
            projekty
            <span class="hidden h-px w-[180px] bg-white/45 sm:block" aria-hidden="true"></span>
          </span>
        </h2>
        <p class="mt-8 font-poppins text-xl font-semibold leading-[1.42] text-white md:text-[24px]">
          LyneoData Platform tworzy jedno, spójne źródło wiedzy o procesach produkcyjnych, wspierając świadome decyzje operacyjne, optymalizację oraz rozwój rozwiązań predykcyjnych.
        </p>
        <a href="mailto:biuro@lyneodata.com" class="group mt-12 inline-flex items-center gap-5 font-poppins text-[18px] font-semibold text-white">
          <span class="flex size-[50px] items-center justify-center rounded-full bg-primary transition-colors group-hover:bg-[#367fac]">
            <span class="ml-0.5 text-[18px]" aria-hidden="true">›</span>
          </span>
          <span>Poznaj projekty</span>
          <span class="hidden h-px w-[180px] bg-white/45 sm:block" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </section>

  <section id="realizacje" class="bg-white py-20 text-[#282828] lg:py-0">
    <div class="mx-auto w-full max-w-[1760px] px-6 sm:px-10 lg:px-20">
      {
        workSteps.map((step) => (
          <article
            class:list={[
              "grid min-h-[760px] items-center gap-12 py-12 lg:grid-cols-2 lg:gap-20 lg:py-0",
              step.reverse && "lg:[&_.work-copy]:order-2 lg:[&_.work-image]:order-1",
            ]}
          >
            <div class="work-copy max-w-[680px]">
              <div class="font-poppins font-semibold leading-none">
                <p class="text-[32px] leading-tight text-primary md:text-[40px]">{step.eyebrow}</p>
                <h2 class="mt-1 text-5xl uppercase leading-[1.05] tracking-[0.05em] text-[#282828] md:text-[60px]">
                  {step.title.map((line) => (
                    <span class="block">{line}</span>
                  ))}
                </h2>
              </div>
              <div class="mt-8 h-px w-full max-w-[480px] bg-[#282828]/45"></div>
              <p class="mt-8 max-w-[560px] font-inter text-[18px] font-semibold leading-[1.2] tracking-[-0.01em] text-[#282828]">
                {step.body}
              </p>
              <a href="/technologia" class="group mt-10 inline-flex items-center gap-5 font-inter text-[20px] font-semibold tracking-[0.05em] text-[#282828]">
                <span class="flex size-[50px] items-center justify-center rounded-full bg-primary text-white transition-colors group-hover:bg-[#367fac]">
                  <span class="ml-0.5 text-[18px]" aria-hidden="true">›</span>
                </span>
                <span>Więcej</span>
              </a>
            </div>
            <div class="work-image">
              <img src={step.image} alt={step.imageAlt} class="aspect-[1.25] w-full rounded-[8px] object-cover shadow-sm" />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <SiteFooter />
</main>
