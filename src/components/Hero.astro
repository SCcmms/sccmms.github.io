---
import { Button } from "@/components/ui/button";
import { TopMenu } from "./ui/top-menu";
---

<section
    class="flex flex-col items-center text-center px-4 bg-black/60 bg-[url('/assets/background.png')] bg-blend-darken bg-cover bg-center h-screen w-full"
>
    <div class="flex justify-between w-full px-16 pt-8 pb-20">
        <img
        src="/assets/logo.png"
        alt="Lyneo Data Logo"
        class="w-80 h-auto"
        />
        <TopMenu client:load/>
    </div>

    <h1 class="text-[108px] mb-4 font-poppins uppercase tracking-wide leading-[1.1]">
        The voice of <br> manufacturing <br> data
    </h1>
    <Button client:load size="lg" className="text-2xl w-60 h-15">Więcej o nas</Button>
</section>
