{
  "name": "lyneodata-landing-page",
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"*.{md,json,mjs}\" \".github/**/*.yml\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"*.{md,json,mjs}\" \".github/**/*.yml\" \"docs/**/*.md\"",
    "verify": "pnpm run check && pnpm run format:check && pnpm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "astro": "^5.15.1",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
